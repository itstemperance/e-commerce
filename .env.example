# ============================================================================
# FLASH SALE E-COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================

# PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flashsale_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/flashsale_db?schema=public&connection_limit=50&pool_timeout=15"

# Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Kafka / Redpanda
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=flashsale-api
KAFKA_GROUP_ID=flashsale-workers-group
SCHEMA_REGISTRY_URL=http://localhost:8081

# API Server & Security
PORT=4000
JWT_ACCESS_SECRET=super_secret_access_key_flashsale_2026
JWT_REFRESH_SECRET=super_secret_refresh_key_flashsale_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PAYMENT_WEBHOOK_SECRET=whsec_flashsale_hmac_secret_2026

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
